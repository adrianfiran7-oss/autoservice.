          </div>
          <div class="input-group">
            <label for="bookingDate">Желаемая дата визита</label>
            <input type="date" id="bookingDate">
          </div>
        </div>

        <div class="input-group">
          <label for="serviceComment">Выбранная услуга или описание проблемы</label>
          <textarea id="serviceComment" rows="3" placeholder="Опишите симптомы (стук, скрип, замена колодок и т.д.)"></textarea>
        </div>

        <div class="modal-bonus">
