  cursor: pointer;
  transition: var(--transition);
}

.tab-btn:hover, .tab-btn.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #ffffff;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.service-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.service-card:hover {
  transform: translateY(-4px);
  border-color: rgba(249, 115, 22, 0.5);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  background: var(--bg-card-hover);
}

.service-icon {
  width: 52px;
  height: 52px;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  border: 1px solid rgba(249, 115, 22, 0.2);
}

.service-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.badge {
  font-size: 0.72rem;
  font-weight: 700;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
  padding: 3px 8px;
  border-radius: var(--radius-sm);
}

.service-price {
  font-size: 1.15rem;
  font-weight: 800;
  color: #ffffff;
}

.service-card h3 {
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10px;
}

.service-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.55;
  margin-bottom: 18px;
}

.service-specs {
  margin-bottom: 24px;
}

.service-specs li {
  font-size: 0.8rem;
  color: #cbd5e1;
  position: relative;
  padding-left: 18px;
  margin-bottom: 6px;
}

.service-specs li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--primary);
  font-weight: 800;
}

/* ==========================================================================
   Interactive Calculator Section
   ========================================================================== */
.calculator-section {
  background: linear-gradient(180deg, var(--bg-main) 0%, #0d1522 100%);
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
}

.calculator-box {
  display: grid;
  grid-template-columns: 1.35fr 0.65fr;
  gap: 30px;
  align-items: start;
}

.calc-steps {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 32px;
}

.calc-step {
  margin-bottom: 32px;
}

.calc-step:last-child {
  margin-bottom: 0;
}

.step-label {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.1rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 18px;
}

.step-num {
  width: 28px;
  height: 28px;
  background: var(--primary);
  color: #ffffff;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 800;
}

.car-types-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.car-type-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 16px 12px;
  text-align: center;
  cursor: pointer;
  transition: var(--transition);
  position: relative;
}

.car-type-card input {
  position: absolute;
  opacity: 0;
}

.car-type-card:hover {
  border-color: var(--primary);
  background: var(--bg-card-hover);
}

.car-type-card.active {
  border-color: var(--primary);
  background: rgba(249, 115, 22, 0.08);
  box-shadow: 0 0 15px rgba(249, 115, 22, 0.2);
}

.car-type-icon {
  font-size: 1.8rem;
  margin-bottom: 8px;
}

.car-type-name {
  font-size: 0.85rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 3px;
}

.car-type-desc {
  font-size: 0.72rem;
  color: var(--text-dim);
}

/* Service Checkboxes */
.calc-services-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.calc-checkbox-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 14px 18px;
  cursor: pointer;
  transition: var(--transition);
  user-select: none;
}

.calc-checkbox-card input {
  display: none;
}

.cb-checkmark {
  width: 20px;
  height: 20px;
  border: 2px solid var(--text-dim);
  border-radius: 4px;
  margin-right: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
  flex-shrink: 0;
}

.calc-checkbox-card input:checked + .cb-checkmark {
  background: var(--primary);
  border-color: var(--primary);
}

.calc-checkbox-card input:checked + .cb-checkmark::after {
  content: '✓';
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 800;
}

.calc-checkbox-card:hover {
  border-color: rgba(255, 255, 255, 0.2);
  background: var(--bg-card-hover);
}

.calc-checkbox-card.selected {
  border-color: rgba(249, 115, 22, 0.4);
  background: rgba(249, 115, 22, 0.04);
}

.cb-info {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.cb-title {
  font-size: 0.92rem;
  font-weight: 600;
  color: #ffffff;
}

.cb-note {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.cb-price {
  font-size: 1rem;
  font-weight: 700;
  color: var(--primary);
  margin-left: 12px;
  white-space: nowrap;
}

/* Calculator Total Column */
.calc-total-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 30px;
  position: sticky;
  top: 90px;
}

.total-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding-bottom: 15px;
  border-bottom: 1px solid var(--border-color);
}

.total-header h4 {
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffffff;
}

.calc-discount-badge {
  font-size: 0.75rem;
  font-weight: 700;
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.3);
  padding: 4px 8px;
  border-radius: var(--radius-sm);
}

.calc-breakdown {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.breakdown-row strong {
  color: #ffffff;
}

.discount-row strong {
  color: #10b981;
}

.divider {
  height: 1px;
  background: var(--border-color);
  margin: 6px 0;
}

.total-price-box {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 4px;
}

.total-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
}

.price-val {
  font-size: 2rem;
  font-weight: 800;
  color: var(--primary);
}

.calc-guarantee-note {
  display: flex;
  gap: 10px;
  font-size: 0.78rem;
  color: var(--text-muted);
  line-height: 1.4;
  margin-bottom: 22px;
  background: rgba(255, 255, 255, 0.02);
  padding: 12px;
  border-radius: var(--radius-sm);
}

.calc-guarantee-note svg {
  color: var(--accent);
  flex-shrink: 0;
}

/* ==========================================================================
   Advantages Section
   ========================================================================== */
.advantages-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}

.adv-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 30px;
  transition: var(--transition);
}

.adv-card:hover {
  border-color: var(--border-highlight);
  transform: translateY(-3px);
  background: var(--bg-card-hover);
}

.adv-icon {
  width: 56px;
  height: 56px;
  background: rgba(56, 189, 248, 0.1);
  color: var(--accent);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.adv-card h3 {
  font-size: 1.18rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10px;
}

.adv-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.6;
}

/* ==========================================================================
   Brands Section
   ========================================================================== */
.brands-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12px;
}

.brand-item {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 16px 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-muted);
  transition: var(--transition);
  text-align: center;
}

.brand-item:hover {
  border-color: var(--primary);
  color: #ffffff;
  background: rgba(249, 115, 22, 0.08);
}

/* ==========================================================================
   Reviews Section
   ========================================================================== */
.rating-badge-center {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.92rem;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-color);
  padding: 8px 18px;
  border-radius: var(--radius-full);
}

.rating-stars {
  color: #eab308;
  letter-spacing: 2px;
}

.reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 36px;
}

.review-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.client-avatar {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, #334155 0%, #1e293b 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--primary);
  border: 1px solid var(--border-highlight);
}

.client-info h4 {
  font-size: 0.95rem;
  font-weight: 700;
  color: #ffffff;
}

.client-car {
  font-size: 0.78rem;
  color: var(--accent);
}

.review-stars {
  margin-left: auto;
  color: #eab308;
  font-size: 0.85rem;
}

.review-text {
  font-size: 0.9rem;
  color: #cbd5e1;
  line-height: 1.6;
  margin-bottom: 20px;
  font-style: italic;
}

.review-date {
  font-size: 0.75rem;
  color: var(--text-dim);
}

/* ==========================================================================
   FAQ Section (Accordion)
   ========================================================================== */
.faq-container {
  max-width: 820px;
}

.accordion {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.faq-item {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: var(--transition);
}

.faq-item:hover {
  border-color: var(--border-highlight);
}

.faq-question {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 24px;
  background: transparent;
  color: #ffffff;
  font-size: 1.02rem;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
}

.faq-arrow {
  color: var(--text-muted);
  transition: transform 0.3s ease;
  flex-shrink: 0;
}

.faq-item.active .faq-arrow {
  transform: rotate(180deg);
  color: var(--primary);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s ease;
  padding: 0 24px;
  color: var(--text-muted);
  font-size: 0.92rem;
  line-height: 1.65;
}

.faq-item.active .faq-answer {
  max-height: 250px;
  padding-bottom: 22px;
}

/* ==========================================================================
   Contacts & Map
   ========================================================================== */
.contacts-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: stretch;
}

.contacts-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.contacts-title {
  font-size: 2.2rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10px;
}

.contacts-subtitle {
  font-size: 1rem;
  color: var(--text-muted);
  margin-bottom: 30px;
}

.contact-items {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.c-item {
  display: flex;
  gap: 16px;
}

.c-icon {
  width: 44px;
  height: 44px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  flex-shrink: 0;
}

.c-label {
  font-size: 0.78rem;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 2px;
}

.c-val {
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
}

.c-hint {
  font-size: 0.82rem;
  color: var(--text-muted);
}

.messengers {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}

.messenger-tag {
  font-size: 0.78rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
}

.messenger-tag.wa {
  background: rgba(37, 211, 102, 0.15);
  color: #25d366;
  border: 1px solid rgba(37, 211, 102, 0.3);
}

.messenger-tag.tg {
  background: rgba(0, 136, 204, 0.15);
  color: #0088cc;
  border: 1px solid rgba(0, 136, 204, 0.3);
}

/* Map Mockup */
.map-placeholder-box {
  background: radial-gradient(circle at 50% 50%, #1e293b 0%, #0b0f19 100%);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  min-height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-mockup {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: 
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 30px 30px;
}

.map-pin {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.pin-dot {
  width: 44px;
  height: 44px;
  background: var(--primary);
  border: 3px solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  box-shadow: 0 4px 20px rgba(249, 115, 22, 0.6);
  z-index: 2;
}

.pin-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90px;
  height: 90px;
  background: rgba(249, 115, 22, 0.25);
  border-radius: 50%;
  animation: pulse 2.5s infinite;
  z-index: 1;
}

.pin-popup {
  position: absolute;
  bottom: 56px;
  background: var(--bg-card);
  border: 1px solid var(--border-highlight);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  white-space: nowrap;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
}

.pin-popup strong {
  font-size: 0.9rem;
  color: #ffffff;
}

.pin-popup span {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.pin-popup .open-status {
  font-size: 0.72rem;
  color: #10b981;
  font-weight: 700;
  margin-top: 3px;
}

.map-overlay-info {
  position: absolute;
  bottom: 20px;
  left: 20px;
  right: 20px;
  background: rgba(11, 15, 25, 0.85);
  backdrop-filter: blur(8px);
  padding: 12px 18px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* ==========================================================================
   Footer
   ========================================================================== */
.footer {
  background: #070a12;
  border-top: 1px solid var(--border-color);
  padding: 70px 0 30px;
}

.footer-top {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  gap: 40px;
  margin-bottom: 50px;
}

.footer-about {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin-top: 16px;
  max-width: 320px;
}

.footer-heading {
  font-size: 1rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 20px;
}

.footer-links li {
  margin-bottom: 10px;
}

.footer-links a {
  font-size: 0.88rem;
  color: var(--text-muted);
}

.footer-links a:hover {
  color: var(--primary);
  padding-left: 4px;
}

.footer-phone a {
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
}

.footer-phone a:hover {
  color: var(--primary);
}

.footer-email, .footer-address {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: 6px;
}

.mt-3 {
  margin-top: 16px;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 25px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 0.8rem;
  color: var(--text-dim);
}

.footer-legal {
  display: flex;
  gap: 20px;
}

.footer-legal a:hover {
  color: var(--text-muted);
}

/* ==========================================================================
   Modal Window
   ========================================================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(5, 8, 15, 0.8);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-overlay.open {
  opacity: 1;
  visibility: visible;
}

.modal-window {
  background: var(--bg-surface);
  border: 1px solid var(--border-highlight);
  border-radius: var(--radius-lg);
  max-width: 540px;
  width: 100%;
  padding: 36px 30px;
  box-shadow: var(--shadow-lg), 0 0 50px rgba(0, 0, 0, 0.6);
  position: relative;
  transform: translateY(20px) scale(0.96);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-overlay.open .modal-window {
  transform: translateY(0) scale(1);
}

.modal-close {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 32px;
  height: 32px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 1.5rem;
  cursor: pointer;
  transition: var(--transition);
}

.modal-close:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.15);
}

.modal-tag {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 0.1em;
  margin-bottom: 6px;
}

.modal-header h3 {
  font-size: 1.45rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 6px;
}

.modal-header p {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-bottom: 22px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.modal-bonus {
  background: rgba(249, 115, 22, 0.08);
  border: 1px dashed rgba(249, 115, 22, 0.4);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.8rem;
  color: #fdba74;
  margin-bottom: 18px;
}

.bonus-icon {
  font-size: 1.2rem;
}

.modal-disclaimer {
  font-size: 0.72rem;
  color: var(--text-dim);
  text-align: center;
  margin-top: 12px;
}

/* ==========================================================================
   Toast Notification
   ========================================================================== */
.toast-notification {
  position: fixed;
  bottom: 25px;
  right: 25px;
  background: #0f172a;
  border: 1px solid #10b981;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 14px;
  z-index: 3000;
  transform: translateY(120%);
  opacity: 0;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.toast-notification.show {
  transform: translateY(0);
  opacity: 1;
}

.toast-icon {
  width: 32px;
  height: 32px;
  background: #10b981;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.toast-body strong {
  display: block;
  font-size: 0.92rem;
  color: #ffffff;
}

.toast-body p {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* ==========================================================================
   Responsive Adaptations
   ========================================================================== */
@media (max-width: 1024px) {
  .hero-container {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .hero-card-wrap {
    max-width: 540px;
    margin: 0 auto;
    width: 100%;
  }

  .calculator-box {
    grid-template-columns: 1fr;
  }

  .calc-total-card {
    position: static;
  }

  .services-grid, .advantages-grid, .reviews-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .brands-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .footer-top {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .header-phone {
    display: none;
  }

  .menu-toggle {
    display: flex;
  }

  .nav-links {
    position: fixed;
    top: 70px;
    left: 0;
    right: 0;
    background: #0d1524;
    border-bottom: 1px solid var(--border-color);
    flex-direction: column;
    padding: 24px;
    gap: 16px;
    transform: translateY(-150%);
    opacity: 0;
    pointer-events: none;
    transition: var(--transition);
  }

  .nav-links.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .hero-title {
    font-size: 2.2rem;
  }

  .hero-metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .offer-banner {
    flex-direction: column;
    text-align: center;
  }

  .services-grid, .advantages-grid, .reviews-grid {
    grid-template-columns: 1fr;
  }

  .car-types-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .contacts-wrapper {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .brands-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-top {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .footer-bottom {
    flex-direction: column;
    gap: 12px;
    text-align: center;
  }
}

